{
    "info": {
      "name": "Kushnath Ayurveda - Customer API",
      "description": "API collection for customer profile management",
      "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
      {
        "key": "base_url",
        "value": "http://localhost:8000",
        "type": "string"
      },
      {
        "key": "access_token",
        "value": "your_jwt_access_token_here",
        "type": "string"
      }
    ],
    "auth": {
      "type": "bearer",
      "bearer": [
        {
          "key": "token",
          "value": "{{access_token}}",
          "type": "string"
        }
      ]
    },
    "item": [
      {
        "name": "Authentication",
        "item": [
          {
            "name": "Get JWT Token",
            "request": {
              "method": "POST",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": {
                "mode": "raw",
                "raw": "{\n  \"username\": \"your_username\",\n  \"password\": \"your_password\"\n}"
              },
              "url": {
                "raw": "{{base_url}}/api/token/",
                "host": ["{{base_url}}"],
                "path": ["api", "token", ""]
              },
              "description": "Get JWT access token for authentication"
            },
            "response": []
          },
          {
            "name": "Refresh JWT Token",
            "request": {
              "method": "POST",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": {
                "mode": "raw",
                "raw": "{\n  \"refresh\": \"your_refresh_token_here\"\n}"
              },
              "url": {
                "raw": "{{base_url}}/api/token/refresh/",
                "host": ["{{base_url}}"],
                "path": ["api", "token", "refresh", ""]
              },
              "description": "Refresh JWT access token using refresh token"
            },
            "response": []
          }
        ]
      },
      {
        "name": "Customer Profile",
        "item": [
          {
            "name": "Get Customer Profile",
            "request": {
              "method": "GET",
              "header": [
                {
                  "key": "Authorization",
                  "value": "Bearer {{access_token}}"
                }
              ],
              "url": {
                "raw": "{{base_url}}/api/customer/profile/",
                "host": ["{{base_url}}"],
                "path": ["api", "customer", "profile", ""]
              },
              "description": "Fetch customer profile data for authenticated user"
            },
            "response": [
              {
                "name": "Success Response",
                "originalRequest": {
                  "method": "GET",
                  "header": [
                    {
                      "key": "Authorization",
                      "value": "Bearer {{access_token}}"
                    }
                  ],
                  "url": {
                    "raw": "{{base_url}}/api/customer/profile/",
                    "host": ["{{base_url}}"],
                    "path": ["api", "customer", "profile", ""]
                  }
                },
                "status": "OK",
                "code": 200,
                "_postman_previewlanguage": "json",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "cookie": [],
                "body": "{\n  \"success\": true,\n  \"data\": {\n    \"id\": 1,\n    \"name\": \"John Doe\",\n    \"email\": \"john@example.com\",\n    \"mobiles\": [\n      {\n        \"id\": 1,\n        \"mobile\": \"1234567890\"\n      },\n      {\n        \"id\": 2,\n        \"mobile\": \"0987654321\"\n      }\n    ],\n    \"addresses\": [\n      {\n        \"id\": 1,\n        \"address\": \"123 Main Street\",\n        \"pincode\": \"12345\",\n        \"city\": \"New York\",\n        \"state\": \"NY\",\n        \"country\": \"USA\"\n      }\n    ],\n    \"more_addresses\": [\n      {\n        \"id\": 1,\n        \"name\": \"Jane Doe\",\n        \"mobile\": \"5555555555\",\n        \"email\": \"jane@example.com\",\n        \"address\": \"456 Oak Avenue\",\n        \"pincode\": \"54321\",\n        \"city\": \"Los Angeles\",\n        \"state\": \"CA\",\n        \"country\": \"USA\"\n      }\n    ]\n  }\n}"
              }
            ]
          },
